# NEXON_OPENAPI_KEY: Required for official NEXON FC Online Open API requests.
# 서버에서만 사용된다. 브라우저로 전달되지 않으며, 클라이언트가 키를 넘기는 경로도 없다.
# Obtain your key at https://openapi.nexon.com
NEXON_OPENAPI_KEY="test_nxapi_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links and API endpoints.
APP_URL="MY_APP_URL"
